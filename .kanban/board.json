{
  "version": 1,
  "repo": "Ioan23/ochelari-cluj",
  "board": "default",
  "skill_version": "0.4.0",
  "dispatch": {
    "interval": 60,
    "max_in_progress": 2,
    "stale_after": 3600,
    "max_runtime_default": 3600,
    "failure_limit": 2,
    "block_recurrence_limit": 3,
    "auth_pause": 1800,
    "recent_success_window": 600,
    "path_guard": true,
    "daily_spawn_cap": 40
  },
  "profiles": {
    "claude": {
      "description": "Claude Code on this machine as a background agent (free path): visible in `claude agents`, attachable with `claude attach <job>`, runs in a git worktree, opens a draft PR, finishes with one hkb terminal verb. The dispatcher stops the job once the attempt has ended.",
      "mode": "claude-bg",
      "heartbeat": "auto",
      "max_in_progress": 2,
      "model": null,
      "allowed_tools": [
        "Bash(hkb *)",
        "Bash(git *)",
        "Bash(gh pr *)",
        "Bash(gh issue view *)",
        "Bash(npm *)",
        "Bash(npx *)",
        "Bash(node *)",
        "Bash(cat *)",
        "Bash(ls *)",
        "Bash(mkdir *)",
        "Bash(head *)",
        "Bash(tail *)",
        "Bash(wc *)",
        "Bash(sed *)",
        "Bash(awk *)",
        "Bash(grep *)",
        "Bash(find *)",
        "Bash(diff *)",
        "Bash(cp *)",
        "Bash(mv *)",
        "Bash(touch *)",
        "Bash(chmod *)",
        "Bash(printf *)",
        "Bash(echo *)",
        "Bash(jq *)",
        "Bash(true)",
        "Edit",
        "Write",
        "Read",
        "Glob",
        "Grep"
      ],
      "launch": [
        "claude",
        "--bg",
        "--name",
        "kb #{n} · {title}",
        "--worktree",
        "kb-{n}-{k}",
        "--permission-mode",
        "dontAsk",
        "--allowedTools",
        "{allowed_tools}",
        "--disallowedTools",
        "Bash(git push --force*)",
        "Bash(git push -f*)",
        "--max-turns",
        "80",
        "--max-budget-usd",
        "5",
        "{model_args}",
        "{prompt}"
      ]
    }
  },
  "default_branch": "master"
}
