# Chei Stripe pentru procesarea plăților (Dashboard Stripe → Developers → API keys)
STRIPE_SECRET_KEY=sk_test_...

# Secretul webhook-ului Stripe (Dashboard Stripe → Developers → Webhooks)
# Necesar doar pentru endpoint-ul /api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_...

# Notificări email pentru confirmarea programărilor la domiciliu (Resend)
# Opțional — fără ele, confirmările sunt simulate în consolă (log)
RESEND_API_KEY=re_...
NOTIFICATIONS_FROM_EMAIL=Ochelari Cluj <programari@ochelaricluj.ro>

# Notificări SMS pentru confirmarea programărilor la domiciliu (Twilio)
# Opțional — fără ele, confirmările sunt simulate în consolă (log)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_FROM_NUMBER=+1...
